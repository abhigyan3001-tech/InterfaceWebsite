# Apache config for Hostinger shared hosting. Upload to the same folder as index.html (public_html).

# Force HTTPS (enable SSL for the domain in hPanel first, or the site will loop/fail)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Don't list directory contents
Options -Indexes

# Hostinger Git deployment clones the whole repository into public_html.
# Block repository-only files (.git, docs, Markdown) with 403 Forbidden. .well-known stays reachable for SSL checks.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]
RewriteRule ^docs(/|$) - [F,L]
RewriteRule \.md$ - [F,L]

<IfModule mod_headers.c>
  # Remember to use HTTPS for 1 year. Only add "; includeSubDomains; preload" once every subdomain is on HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Support self assets, inline theme initialization, and audio streaming
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# Correct MIME types
AddType image/svg+xml .svg
AddType audio/mpeg .mp3

# Cache static assets for a week; HTML always revalidates so edits show up immediately
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType audio/mpeg "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
